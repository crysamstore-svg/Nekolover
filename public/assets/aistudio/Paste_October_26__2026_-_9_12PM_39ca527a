<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>NekoLover Read 🐾🖤 Lector Kawaii Dark & EPUB/PDF</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts: Dark Reborn & Kawaii Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Pirata+One&family=UnifrakturMaguntia&family=Creepster&family=Quicksand:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <!-- PDF.js library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

    <!-- ePub.js & JSZip libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/epub.js/0.3.88/epub.min.js"></script>

    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Quicksand', 'sans-serif'],
                        cute: ['Fredoka', 'cursive'],
                        reborn: ['"Cinzel Decorative"', '"Pirata One"', 'serif'],
                        gothic: ['"UnifrakturMaguntia"', 'cursive'],
                        creepster: ['"Creepster"', 'cursive'],
                        serif_classic: ['"Playfair Display"', 'serif'],
                        lora: ['"Lora"', 'serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Theme Presets via CSS Custom Variables */
        :root[data-theme="kawaii-dark"] {
            --bg-color: #121019;
            --card-bg: #1a1726;
            --border-color: #2a243d;
            --accent-pink: #ff79c6;
            --accent-purple: #bd93f9;
            --text-main: #e2d6ff;
            --shelf-color: #241b35;
            --shelf-border: #ff79c6;
            --reader-bg: #1a1726;
            --reader-text: #e2d6ff;
        }

        :root[data-theme="vanilla-fresa"] {
            --bg-color: #21131b;
            --card-bg: #2d1a25;
            --border-color: #48283b;
            --accent-pink: #ff85a2;
            --accent-purple: #fce1e4;
            --text-main: #fff0f3;
            --shelf-color: #3b2030;
            --shelf-border: #ff85a2;
            --reader-bg: #fff0f3;
            --reader-text: #2d1a25;
        }

        :root[data-theme="nocturno"] {
            --bg-color: #05070d;
            --card-bg: #0b0f19;
            --border-color: #182238;
            --accent-pink: #80b3ff;
            --accent-purple: #a8c8fb;
            --text-main: #d1e2ff;
            --shelf-color: #0e172a;
            --shelf-border: #3b82f6;
            --reader-bg: #030509;
            --reader-text: #c0d8ff;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Quicksand', sans-serif;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .dark-reborn-title {
            font-family: 'Cinzel Decorative', 'Pirata One', serif;
            letter-spacing: 0.05em;
            text-shadow: 0 0 12px var(--accent-pink);
        }

        .dark-reborn-font {
            font-family: 'Cinzel Decorative', serif;
        }

        .bg-theme-card { background-color: var(--card-bg); }
        .border-theme { border-color: var(--border-color); }
        .text-accent-pink { color: var(--accent-pink); }
        .text-accent-purple { color: var(--accent-purple); }
        .bg-accent-pink { background-color: var(--accent-pink); }
        .bg-accent-purple { background-color: var(--accent-purple); }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-color);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 99px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent-pink);
        }

        /* Movable Stickers */
        .movable-sticker {
            position: absolute;
            cursor: move;
            user-select: none;
            touch-action: none;
            z-index: 25;
            transition: transform 0.1s ease;
            filter: drop-shadow(0px 3px 6px rgba(0,0,0,0.6));
        }
        .movable-sticker:active {
            transform: scale(1.22) rotate(4deg);
        }

        .shelf-texture {
            background: linear-gradient(180deg, var(--shelf-color) 0%, #0a0810 100%);
            border-bottom: 6px solid var(--shelf-border);
            box-shadow: 0 8px 18px rgba(0,0,0,0.7);
        }

        /* Cat ears badge decoration */
        .cat-ears-badge {
            position: relative;
        }
        .cat-ears-badge::before, .cat-ears-badge::after {
            content: '';
            position: absolute;
            top: -6px;
            width: 0;
            height: 0;
            border-left: 6px solid transparent;
            border-right: 6px solid transparent;
            border-bottom: 8px solid var(--accent-pink);
        }
        .cat-ears-badge::before { left: 4px; transform: rotate(-15deg); }
        .cat-ears-badge::after { right: 4px; transform: rotate(15deg); }

        .modal-animate {
            animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popIn {
            from { opacity: 0; transform: scale(0.92); }
            to { opacity: 1; transform: scale(1); }
        }

        #epub-render {
            width: 100% !important;
            height: 100% !important;
            min-height: 60vh;
        }
    </style>
</head>
<body class="h-full flex flex-col min-h-screen selection:bg-pink-500 selection:text-black">

    <!-- TOP NAVIGATION HEADER -->
    <header class="bg-theme-card border-b border-theme sticky top-0 z-40 px-3 sm:px-6 py-2.5 flex items-center justify-between shadow-lg">
        <!-- Logo & Title with Dark Reborn Font -->
        <div class="flex items-center space-x-2 sm:space-x-3 cursor-pointer" onclick="switchView('library')">
            <div class="cat-ears-badge w-10 h-10 rounded-2xl bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center text-xl shadow-lg">
                🐾
            </div>
            <div>
                <h1 class="dark-reborn-title text-base sm:text-xl font-bold bg-gradient-to-r from-pink-400 via-purple-300 to-blue-400 bg-clip-text text-transparent leading-tight">
                    NekoLover Read
                </h1>
                <p class="text-[10px] sm:text-xs text-accent-purple font-medium">Dark Reborn & EPUB Engine 🦇🖤</p>
            </div>
        </div>

        <!-- Navigation Bar & Theme Picker Trigger -->
        <nav class="flex items-center space-x-1.5 sm:space-x-3">
            <button onclick="switchView('library')" id="nav-library" class="px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition bg-accent-pink text-black shadow-md">
                <i class="fa-solid fa-cat"></i>
                <span class="hidden sm:inline">Biblioteca</span>
            </button>
            <button onclick="switchView('quotes')" id="nav-quotes" class="px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition hover:bg-white/10">
                <i class="fa-solid fa-quote-right"></i>
                <span class="hidden sm:inline">Notas</span>
            </button>

            <!-- Theme Switcher Menu Trigger -->
            <button onclick="toggleGlobalThemeModal()" class="px-3 py-2 bg-black/40 border border-theme rounded-xl text-xs text-accent-pink font-cute flex items-center gap-1.5 hover:border-pink-400 transition" title="Cambiar Tema global">
                <i class="fa-solid fa-palette"></i>
                <span class="hidden md:inline">Temas</span>
            </button>

            <!-- Native File Upload Button (PDF & EPUB) -->
            <label for="mobile-file-input" class="px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-pink-500/20 text-accent-pink border border-pink-500/40 hover:bg-pink-500 hover:text-black transition flex items-center space-x-1.5 cursor-pointer shadow-sm">
                <i class="fa-solid fa-file-circle-plus"></i>
                <span>Subir Archivo</span>
            </label>
            <input type="file" id="mobile-file-input" accept=".pdf,.epub" multiple class="hidden" onchange="handleNativeFileSelect(event)">
        </nav>
    </header>

    <!-- MAIN VIEW AREA -->
    <main class="flex-1 flex flex-col">

        <!-- 1. LIBRARY VIEW -->
        <section id="view-library" class="p-3 sm:p-6 max-w-7xl mx-auto w-full flex-1">
            <!-- Search & Controls Bar -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-6 bg-theme-card p-3 sm:p-4 rounded-2xl border border-theme shadow-lg">
                <!-- Category Buttons -->
                <div class="flex items-center space-x-1.5 overflow-x-auto pb-2 md:pb-0 scrollbar-none">
                    <button onclick="filterCategory('all')" class="cat-btn active px-3 py-1.5 rounded-full text-xs font-bold transition bg-accent-pink text-black shrink-0">Todos</button>
                    <button onclick="filterCategory('reading')" class="cat-btn px-3 py-1.5 rounded-full text-xs font-bold transition bg-black/30 hover:bg-black/50 shrink-0">📖 Leyendo</button>
                    <button onclick="filterCategory('unread')" class="cat-btn px-3 py-1.5 rounded-full text-xs font-bold transition bg-black/30 hover:bg-black/50 shrink-0">🐾 Pendientes</button>
                    <button onclick="filterCategory('completed')" class="cat-btn px-3 py-1.5 rounded-full text-xs font-bold transition bg-black/30 hover:bg-black/50 shrink-0">✨ Leídos</button>
                    <button onclick="filterCategory('favorites')" class="cat-btn px-3 py-1.5 rounded-full text-xs font-bold transition bg-black/30 hover:bg-black/50 shrink-0">🖤 Favoritos</button>
                </div>

                <!-- Search Input -->
                <div class="relative flex-1 sm:w-60">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-accent-purple/60 text-xs"></i>
                    <input type="text" id="search-input" onkeyup="renderLibrary()" placeholder="Buscar por título o autor..." class="w-full bg-black/40 border border-theme rounded-xl pl-8 pr-3 py-1.5 text-xs text-white focus:outline-none focus:border-pink-400">
                </div>
            </div>

            <!-- BOOKSHELF DISPLAY AREA -->
            <div id="shelf-container" class="space-y-10">
                <!-- Shelves rendered here -->
            </div>
        </section>

        <!-- 2. BOOK READER VIEW -->
        <section id="view-reader" class="hidden flex-1 flex flex-col h-[calc(100vh-62px)] bg-black/90 relative overflow-hidden">
            <!-- Reader Navbar -->
            <div class="bg-theme-card border-b border-theme px-3 py-2 flex items-center justify-between z-30 shadow-md">
                <div class="flex items-center space-x-2 truncate pr-2">
                    <button onclick="switchView('library')" class="p-1.5 hover:text-pink-400 transition" title="Volver">
                        <i class="fa-solid fa-arrow-left text-base"></i>
                    </button>
                    <span id="reader-book-title" class="dark-reborn-font font-bold text-xs sm:text-sm text-accent-pink truncate max-w-[120px] sm:max-w-xs">Nombre del Libro</span>
                </div>

                <!-- Page Controls -->
                <div class="flex items-center space-x-1.5">
                    <button onclick="changePage(-1)" class="px-2.5 py-1 bg-black/40 rounded-lg hover:bg-white/10 transition text-xs"><i class="fa-solid fa-chevron-left"></i></button>
                    <span class="text-[11px] text-accent-purple font-mono px-1"><span id="current-page">1</span>/<span id="total-pages">1</span></span>
                    <button onclick="changePage(1)" class="px-2.5 py-1 bg-black/40 rounded-lg hover:bg-white/10 transition text-xs"><i class="fa-solid fa-chevron-right"></i></button>
                </div>

                <!-- Reader Actions -->
                <div class="flex items-center space-x-1.5">
                    <button onclick="toggleFontSettingsModal()" class="p-1.5 bg-black/40 border border-theme hover:border-pink-400 rounded-lg text-xs text-accent-pink" title="Estilo de Letra Dark Reborn">
                        <i class="fa-solid fa-font"></i>
                    </button>
                    <button onclick="toggleGlobalThemeModal()" class="p-1.5 bg-black/40 border border-theme hover:border-pink-400 rounded-lg text-xs text-accent-pink" title="Temas Rápidos">
                        <i class="fa-solid fa-palette"></i>
                    </button>
                    <button onclick="toggleStickerDrawer()" class="px-2.5 py-1.5 bg-pink-500/20 border border-pink-500/40 text-accent-pink rounded-xl text-xs font-semibold hover:bg-pink-500 hover:text-black transition flex items-center space-x-1">
                        <span>🎀</span> <span class="hidden sm:inline">Stickers</span>
                    </button>
                    <button onclick="openAddNoteModal()" class="px-2.5 py-1.5 bg-purple-500/20 border border-purple-500/40 text-accent-purple rounded-xl text-xs font-semibold hover:bg-purple-500 hover:text-black transition flex items-center space-x-1">
                        <i class="fa-solid fa-feather"></i> <span class="hidden sm:inline">Cita</span>
                    </button>
                </div>
            </div>

            <!-- Sticker Floating Drawer -->
            <div id="sticker-drawer" class="hidden absolute top-12 right-2 sm:right-6 z-40 bg-theme-card border border-theme p-3 rounded-2xl shadow-2xl w-64 modal-animate">
                <div class="flex items-center justify-between border-b border-theme pb-2 mb-2">
                    <span class="font-cute text-xs text-accent-pink font-bold">🐾 Stickers Movibles</span>
                    <button onclick="toggleStickerDrawer()" class="text-xs text-accent-purple hover:text-white"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="grid grid-cols-4 gap-2 max-h-48 overflow-y-auto p-1" id="sticker-palette">
                    <!-- Dynamic Stickers -->
                </div>
                <p class="text-[10px] text-accent-purple/80 text-center mt-2">Toca un sticker para pegarlo. Arrástralo libremente con el dedo o ratón.</p>
            </div>

            <!-- Reader Canvas & Container -->
            <div class="flex-1 relative overflow-auto flex justify-center items-start p-2 sm:p-4" id="reader-viewport">
                <div id="page-container" class="relative shadow-2xl min-h-[500px] w-full max-w-3xl rounded-xl overflow-hidden transition-all my-auto p-2 sm:p-4" style="background-color: var(--reader-bg); color: var(--reader-text);">
                    <!-- PDF Canvas -->
                    <canvas id="pdf-canvas" class="block mx-auto max-w-full hidden shadow-lg rounded"></canvas>
                    
                    <!-- EPUB Render Div -->
                    <div id="epub-render" class="w-full h-full min-h-[550px] hidden"></div>
                    
                    <!-- Demo Text Render -->
                    <div id="demo-reader" class="p-4 sm:p-8 text-sm sm:text-base leading-relaxed hidden"></div>

                    <!-- Movable Sticker Layer -->
                    <div id="sticker-layer" class="absolute inset-0 pointer-events-auto">
                        <!-- Placed stickers -->
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. QUOTES & NOTES VAULT VIEW -->
        <section id="view-quotes" class="hidden p-3 sm:p-6 max-w-6xl mx-auto w-full flex-1">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-6">
                <div>
                    <h2 class="dark-reborn-title text-xl sm:text-2xl font-bold text-accent-pink flex items-center gap-2">
                        <span>💬</span> Citas & Notas Dark Reborn
                    </h2>
                    <p class="text-xs text-accent-purple">Tus fragmentos literarios guardados con estilo</p>
                </div>
                <div class="relative w-full sm:w-64">
