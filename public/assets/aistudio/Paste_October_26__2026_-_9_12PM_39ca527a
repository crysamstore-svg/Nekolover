    <!-- MODAL: DARK REBORN FONT SELECTOR -->
    <div id="modal-font-settings" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-theme-card border border-theme rounded-3xl p-5 max-w-sm w-full shadow-2xl relative modal-animate">
            <button onclick="toggleFontSettingsModal()" class="absolute top-4 right-4 text-accent-purple hover:text-pink-400"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="dark-reborn-font font-bold text-lg text-accent-pink mb-4 text-center">🦇 Tipografía Dark Reborn</h3>
            
            <div class="space-y-2.5">
