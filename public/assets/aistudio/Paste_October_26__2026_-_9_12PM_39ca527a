                    <div>
                        <label class="block text-xs font-semibold text-white mb-1">Categoría</label>
                        <select id="note-emotion" class="w-full bg-black/40 border border-theme rounded-xl px-2 py-2 text-xs text-white focus:border-pink-400 focus:outline-none">
                            <option value="🖤 Dark Reborn">🖤 Dark Reborn</option>
                            <option value="🍓 Vainilla Fresa">🍓 Vainilla Fresa</option>
                            <option value="💖 Favorito">💖 Favorito</option>
                            <option value="🦇 Oscuro">🦇 Oscuro</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-white mb-1">Reflexión Personal</label>
                    <input type="text" id="note-comment" placeholder="¿Qué sentiste al leer esto?" class="w-full bg-black/40 border border-theme rounded-xl px-3 py-2 text-xs text-white focus:border-pink-400 focus:outline-none">
                </div>
                <button type="submit" class="w-full py-2.5 bg-accent-pink text-black font-cute font-bold rounded-xl shadow-lg hover:opacity-90 transition mt-2">
                    Guardar Nota 🐾
                </button>
            </form>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // IndexedDB Configuration for Persistent PDF/EPUB Storage
        const DB_NAME = 'NekoLoverReadDB';
        const DB_VERSION = 1;
        let db = null;

        function initDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(DB_NAME, DB_VERSION);
                request.onupgradeneeded = (e) => {
                    const database = e.target.result;
                    if (!database.objectStoreNames.contains('files')) {
                        database.createObjectStore('files');
                    }
                };
                request.onsuccess = (e) => {
                    db = e.target.result;
                    resolve(db);
                };
                request.onerror = (e) => reject(e);
            });
        }

        function saveFileToIDB(id, fileBlob) {
            return new Promise((resolve, reject) => {
                if (!db) return resolve();
                const tx = db.transaction('files', 'readwrite');
                const store = tx.objectStore('files');
                store.put(fileBlob, id);
                tx.oncomplete = () => resolve();
                tx.onerror = (e) => reject(e);
            });
        }

        function getFileFromIDB(id) {
            return new Promise((resolve, reject) => {
                if (!db) return resolve(null);
                const tx = db.transaction('files', 'readonly');
                const store = tx.objectStore('files');
                const request = store.get(id);
                request.onsuccess = () => resolve(request.result);
                request.onerror = (e) => reject(e);
            });
        }

        // APP STATE
        let books = [
            {
                id: 'demo-neko-1',
                title: 'El Gato Negro & Las Sombras Kawaii',
                author: 'Sora Neko',
                category: 'reading',
                favorite: true,
                emoji: '🐈‍⬛',
                type: 'demo',
                content: [
                    "Página 1: En una vieja mansión de tejados oscuros y destellos fucsia, un gatito negro abría lentamente sus ojitos brillantes.",
                    "Página 2: Las sombras de la noche no eran oscuras ni frías; olían a vainilla, fresa y misterios góticos renacidos.",
                    "Página 3: ¡Bienvenido a NekoLover Read! Puedes cargar tus propios libros EPUB y PDF desde tu dispositivo, añadir stickers flotantes y personalizar la tipografía Dark Reborn."
                ]
            }
        ];

        let quotes = [
            {
                id: 'q-demo-1',
                bookTitle: 'El Gato Negro & Las Sombras Kawaii',
                chapter: 'Pág. 2',
                emotion: '🖤 Dark Reborn',
                text: 'Las sombras de la noche no eran frías; olían a vainilla, fresa y misterios góticos.',
                comment: 'Excelente frase estilo Dark Reborn.'
            }
        ];

        const KAWAII_STICKERS = ['🐈‍⬛', '🐾', '🍓', '🧁', '🦇', '💀', '🖤', '🎀', '🧪', '🕯️', '🔮', '✨', '☕', '🗡️', '🥀', '🌙'];
        let pageStickers = {};
        let currentTheme = 'kawaii-dark';
        let currentCategoryFilter = 'all';
        let currentBook = null;
        let currentPageNum = 1;
        let totalPagesNum = 1;
        let pdfDoc = null;
        let epubBook = null;
        let epubRendition = null;
        let currentReaderFont = 'Quicksand, sans-serif';

        // INIT APP
        window.addEventListener('DOMContentLoaded', async () => {
            try { await initDB(); } catch (err) {}
            loadLocalStorage();
            applyGlobalTheme(currentTheme);
            renderLibrary();
            renderStickerPalette();
        });

        function saveLocalStorage() {
            localStorage.setItem('nl_books', JSON.stringify(books));
            localStorage.setItem('nl_quotes', JSON.stringify(quotes));
            localStorage.setItem('nl_stickers', JSON.stringify(pageStickers));
            localStorage.setItem('nl_theme', currentTheme);
        }

        function loadLocalStorage() {
            const b = localStorage.getItem('nl_books');
            const q = localStorage.getItem('nl_quotes');
            const s = localStorage.getItem('nl_stickers');
            const t = localStorage.getItem('nl_theme');
            if (b) books = JSON.parse(b);
            if (q) quotes = JSON.parse(q);
            if (s) pageStickers = JSON.parse(s);
            if (t) currentTheme = t;
        }

        // THEME MANAGEMENT
        function toggleGlobalThemeModal() {
            document.getElementById('modal-global-theme').classList.toggle('hidden');
        }

        function applyGlobalTheme(themeName) {
            currentTheme = themeName;
            document.documentElement.setAttribute('data-theme', themeName);

            document.querySelectorAll('.theme-check').forEach(el => el.classList.add('hidden'));
            const activeCheck = document.getElementById(`check-${themeName}`);
            if (activeCheck) activeCheck.classList.remove('hidden');

            saveLocalStorage();
            renderLibrary();
        }

        function toggleFontSettingsModal() {
            document.getElementById('modal-font-settings').classList.toggle('hidden');
        }

        function applyReaderFont(fontFamily) {
            currentReaderFont = fontFamily;
            const demoReader = document.getElementById('demo-reader');
            demoReader.style.fontFamily = fontFamily;
            if (epubRendition) {
                epubRendition.themes.font(fontFamily);
            }
            toggleFontSettingsModal();
        }

        // VIEW NAVIGATION
        function switchView(viewName) {
            document.getElementById('view-library').classList.add('hidden');
            document.getElementById('view-reader').classList.add('hidden');
            document.getElementById('view-quotes').classList.add('hidden');

            document.getElementById('nav-library').className = "px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition hover:bg-white/10";
            document.getElementById('nav-quotes').className = "px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition hover:bg-white/10";

            if (viewName === 'library') {
                document.getElementById('view-library').classList.remove('hidden');
                document.getElementById('nav-library').className = "px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition bg-accent-pink text-black shadow-md";
                renderLibrary();
            } else if (viewName === 'quotes') {
                document.getElementById('view-quotes').classList.remove('hidden');
                document.getElementById('nav-quotes').className = "px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition bg-accent-pink text-black shadow-md";
                renderNotes();
            } else if (viewName === 'reader') {
                document.getElementById('view-reader').classList.remove('hidden');
            }
        }

        // MOBILE FILE INPUT FOR EPUB & PDF
        async function handleNativeFileSelect(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const bookId = 'book-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4);
                const fileExt = file.name.split('.').pop().toLowerCase();
                
                let type = 'pdf';
                let emoji = '🦇';
                if (fileExt === 'epub') {
                    type = 'epub';
                    emoji = '📗';
                }

                await saveFileToIDB(bookId, file);

                const newBook = {
                    id: bookId,
                    title: file.name.replace(/\.[^/.]+$/, ""),
                    author: 'Dispositivo Local',
                    category: 'unread',
                    favorite: false,
                    emoji: emoji,
                    type: type
                };

                books.unshift(newBook);
            }

            saveLocalStorage();
            renderLibrary();
            event.target.value = '';
        }

        // LIBRARY & SHELF RENDERING
        function filterCategory(cat) {
            currentCategoryFilter = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn px-3 py-1.5 rounded-full text-xs font-bold transition bg-black/30 hover:bg-black/50 shrink-0";
            });
            event.target.className = "cat-btn active px-3 py-1.5 rounded-full text-xs font-bold transition bg-accent-pink text-black shrink-0";
            renderLibrary();
        }

        function renderLibrary() {
            const container = document.getElementById('shelf-container');
            const searchQuery = document.getElementById('search-input').value.toLowerCase();
            container.innerHTML = '';

            let filtered = books.filter(book => {
                const matchesSearch = book.title.toLowerCase().includes(searchQuery) || book.author.toLowerCase().includes(searchQuery);
                if (currentCategoryFilter === 'all') return matchesSearch;
                if (currentCategoryFilter === 'favorites') return matchesSearch && book.favorite;
                return matchesSearch && book.category === currentCategoryFilter;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-16 text-accent-purple/60">
                        <p class="text-4xl mb-2">🐾</p>
                        <p class="font-cute text-sm">No hay libros en esta estantería...</p>
                    </div>
                `;
                return;
            }

            const chunkSize = window.innerWidth < 640 ? 3 : 4;
            for (let i = 0; i < filtered.length; i += chunkSize) {
                const shelfBooks = filtered.slice(i, i + chunkSize);
                
                const shelfEl = document.createElement('div');
                shelfEl.className = 'relative mb-6';

                let booksHTML = shelfBooks.map(book => `
                    <div class="group relative flex flex-col items-center w-24 sm:w-32 cursor-pointer transform hover:-translate-y-2 transition-all duration-300" onclick="openBook('${book.id}')">
                        <div class="w-20 sm:w-28 h-28 sm:h-40 rounded-r-lg rounded-l-xs bg-gradient-to-br from-black/40 via-theme-card to-black/80 border-r-4 border-pink-500/60 p-2 sm:p-3 shadow-xl flex flex-col justify-between relative overflow-hidden">
                            <div class="flex justify-between items-start">
                                <span class="text-xl sm:text-2xl">${book.emoji}</span>
                                <button onclick="event.stopPropagation(); toggleFavorite('${book.id}')" class="text-xs ${book.favorite ? 'text-pink-400' : 'text-gray-500 hover:text-pink-400'}">
                                    <i class="fa-solid fa-heart"></i>
                                </button>
                            </div>
                            <div>
                                <h4 class="dark-reborn-font font-bold text-[11px] sm:text-xs text-accent-pink leading-tight line-clamp-2">${book.title}</h4>
                                <p class="text-[9px] text-accent-purple truncate mt-0.5">${book.author}</p>
                            </div>
                            <div class="absolute bottom-0 right-0 left-0 h-1 bg-gradient-to-r from-pink-500 to-purple-500"></div>
                        </div>
                        <div class="w-16 h-1.5 bg-black/60 rounded-full blur-xs mt-1"></div>
                    </div>
                `).join('');

                shelfEl.innerHTML = `
                    <div class="flex items-end justify-around px-2 sm:px-6 pb-1">
                        ${booksHTML}
                    </div>
                    <div class="shelf-texture h-4 w-full rounded-md flex items-center justify-between px-3 text-[10px] text-accent-pink/70">
                        <span>🐾</span>
                        <span>🖤</span>
                        <span>🐾</span>
                    </div>
                `;

                container.appendChild(shelfEl);
            }
        }

        function toggleFavorite(id) {
            const b = books.find(x => x.id === id);
            if (b) {
                b.favorite = !b.favorite;
                saveLocalStorage();
                renderLibrary();
            }
        }

        // READER LOGIC FOR EPUB, PDF & DEMO
        async function openBook(id) {
            currentBook = books.find(b => b.id === id);
            if (!currentBook) return;

            document.getElementById('reader-book-title').innerText = currentBook.title;
            currentPageNum = 1;

            switchView('reader');

            const pdfCanvas = document.getElementById('pdf-canvas');
            const epubRender = document.getElementById('epub-render');
            const demoReader = document.getElementById('demo-reader');

            pdfCanvas.classList.add('hidden');
            epubRender.classList.add('hidden');
            demoReader.classList.add('hidden');

            if (epubRendition) {
                try { epubRendition.destroy(); } catch(e){}
                epubRendition = null;
            }

            if (currentBook.type === 'demo') {
                demoReader.classList.remove('hidden');
                demoReader.style.fontFamily = currentReaderFont;
                totalPagesNum = currentBook.content.length;
                renderDemoPage(currentPageNum);
            } else {
                const fileBlob = await getFileFromIDB(currentBook.id);
                if (!fileBlob) {
                    alert('No se pudo abrir el archivo local del dispositivo.');
                    switchView('library');
                    return;
                }

                const arrayBuffer = await fileBlob.arrayBuffer();

                if (currentBook.type === 'pdf') {
                    pdfCanvas.classList.remove('hidden');
                    pdfjsLib.getDocument({ data: arrayBuffer }).promise.then(pdf => {
                        pdfDoc = pdf;
                        totalPagesNum = pdf.numPages;
                        renderPdfPage(currentPageNum);
                    }).catch(err => {
                        alert('Error al procesar el archivo PDF.');
                        switchView('library');
                    });
                } else if (currentBook.type === 'epub') {
                    epubRender.classList.remove('hidden');
                    try {
                        epubBook = ePub(arrayBuffer);
                        epubRendition = epubBook.renderTo("epub-render", {
                            width: "100%",
                            height: "100%",
                            spread: "none"
                        });
                        
                        await epubRendition.display();
                        epubRendition.themes.font(currentReaderFont);

                        totalPagesNum = 50; // Dynamic estimation for EPUB chapters
                        document.getElementById('current-page').innerText = currentPageNum;
                        document.getElementById('total-pages').innerText = totalPagesNum;
                        renderStickersForPage();
                    } catch(e) {
                        alert('Error al procesar el archivo EPUB.');
                        switchView('library');
                    }
                }
            }
        }

        function renderDemoPage(pageNum) {
            document.getElementById('current-page').innerText = pageNum;
            document.getElementById('total-pages').innerText = totalPagesNum;

            const demoReader = document.getElementById('demo-reader');
            demoReader.innerText = currentBook.content[pageNum - 1] || "Página vacía";
            renderStickersForPage();
        }

        function renderPdfPage(pageNum) {
            document.getElementById('current-page').innerText = pageNum;
            document.getElementById('total-pages').innerText = totalPagesNum;

            pdfDoc.getPage(pageNum).then(page => {
                const canvas = document.getElementById('pdf-canvas');
                const ctx = canvas.getContext('2d');
                
                const containerWidth = document.getElementById('page-container').clientWidth || 600;
                const unscaledViewport = page.getViewport({ scale: 1.0 });
                const scale = containerWidth / unscaledViewport.width;
                const viewport = page.getViewport({ scale: scale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                page.render({ canvasContext: ctx, viewport: viewport }).promise.then(() => {
                    renderStickersForPage();
                });
            });
        }

        function changePage(delta) {
            if (!currentBook) return;
            
            if (currentBook.type === 'epub' && epubRendition) {
                if (delta > 0) epubRendition.next();
                else epubRendition.prev();
                currentPageNum = Math.max(1, currentPageNum + delta);
                document.getElementById('current-page').innerText = currentPageNum;
                renderStickersForPage();
                return;
            }

            const newPage = currentPageNum + delta;
            if (newPage >= 1 && newPage <= totalPagesNum) {
                currentPageNum = newPage;
                if (currentBook.type === 'pdf') {
                    renderPdfPage(currentPageNum);
                } else {
                    renderDemoPage(currentPageNum);
                }
            }
        }

        // STICKERS LOGIC
        function toggleStickerDrawer() {
            document.getElementById('sticker-drawer').classList.toggle('hidden');
        }

        function renderStickerPalette() {
            const palette = document.getElementById('sticker-palette');
            palette.innerHTML = KAWAII_STICKERS.map(emoji => `
                <button onclick="addStickerToPage('${emoji}')" class="text-2xl p-1.5 rounded-xl bg-black/40 hover:bg-white/10 transition transform hover:scale-125">
                    ${emoji}
                </button>
            `).join('');
        }

        function getPageKey() {
            return `${currentBook.id}-p${currentPageNum}`;
        }

        function addStickerToPage(emoji) {
            const key = getPageKey();
            if (!pageStickers[key]) pageStickers[key] = [];

            const newSticker = {
                id: 'stk-' + Date.now(),
                emoji: emoji,
                x: 40 + Math.random() * 40,
                y: 40 + Math.random() * 40
            };

            pageStickers[key].push(newSticker);
            saveLocalStorage();
            renderStickersForPage();
        }

        function renderStickersForPage() {
            const layer = document.getElementById('sticker-layer');
            layer.innerHTML = '';

            if (!currentBook) return;
            const key = getPageKey();
            const stickers = pageStickers[key] || [];

            stickers.forEach(stk => {
                const el = document.createElement('div');
                el.className = 'movable-sticker text-3xl select-none';
                el.style.left = `${stk.x}px`;
                el.style.top = `${stk.y}px`;
                el.innerText = stk.emoji;

                makeDraggableAndTouch(el, stk);

                el.ondblclick = () => {
                    pageStickers[key] = pageStickers[key].filter(s => s.id !== stk.id);
                    saveLocalStorage();
                    renderStickersForPage();
                };

                layer.appendChild(el);
            });
        }

        function makeDraggableAndTouch(element, stickerObj) {
            let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;

            element.onmousedown = dragMouseDown;
            element.ontouchstart = dragTouchStart;

            function dragMouseDown(e) {
                e.preventDefault();
                pos3 = e.clientX;
                pos4 = e.clientY;
                document.onmouseup = closeDragElement;
                document.onmousemove = elementDrag;
            }

            function dragTouchStart(e) {
                const touch = e.touches[0];
                pos3 = touch.clientX;
                pos4 = touch.clientY;
                document.ontouchend = closeDragElement;
                document.ontouchmove = elementTouchDrag;
            }

            function elementDrag(e) {
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;

                let newY = element.offsetTop - pos2;
                let newX = element.offsetLeft - pos1;

                element.style.top = newY + "px";
                element.style.left = newX + "px";

                stickerObj.x = newX;
                stickerObj.y = newY;
            }

            function elementTouchDrag(e) {
                const touch = e.touches[0];
                pos1 = pos3 - touch.clientX;
                pos2 = pos4 - touch.clientY;
                pos3 = touch.clientX;
                pos4 = touch.clientY;

                let newY = element.offsetTop - pos2;
                let newX = element.offsetLeft - pos1;

                element.style.top = newY + "px";
                element.style.left = newX + "px";

                stickerObj.x = newX;
                stickerObj.y = newY;
            }

            function closeDragElement() {
                document.onmouseup = null;
                document.onmousemove = null;
                document.ontouchend = null;
                document.ontouchmove = null;
                saveLocalStorage();
            }
        }

        // NOTES & QUOTES VAULT
        function openAddNoteModal() {
            document.getElementById('modal-note').classList.remove('hidden');
        }
        function closeAddNoteModal() {
            document.getElementById('modal-note').classList.add('hidden');
        }

        function handleSaveNote(e) {
            e.preventDefault();
            const text = document.getElementById('note-text').value;
            const chapter = document.getElementById('note-chapter').value || `Pág. ${currentPageNum}`;
            const emotion = document.getElementById('note-emotion').value;
            const comment = document.getElementById('note-comment').value;

            const newNote = {
                id: 'q-' + Date.now(),
                bookTitle: currentBook ? currentBook.title : 'Libro General',
                chapter: chapter,
                emotion: emotion,
                text: text,
                comment: comment
            };

            quotes.unshift(newNote);
            saveLocalStorage();
            closeAddNoteModal();
            document.getElementById('note-text').value = '';
            document.getElementById('note-comment').value = '';
        }

        function renderNotes() {
            const grid = document.getElementById('notes-grid');
            const search = document.getElementById('notes-search').value.toLowerCase();
            grid.innerHTML = '';

            const filtered = quotes.filter(q => q.text.toLowerCase().includes(search) || q.bookTitle.toLowerCase().includes(search));

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-12 text-accent-purple/60">
                        <p class="text-3xl mb-2">💬</p>
                        <p class="font-cute text-sm">No hay citas registradas aún...</p>
                    </div>
                `;
                return;
            }

            filtered.forEach(q => {
                const card = document.createElement('div');
                card.className = "bg-theme-card border border-theme rounded-2xl p-4 shadow-lg flex flex-col justify-between hover:border-pink-400 transition";
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between text-xs text-accent-pink mb-2">
                            <span class="dark-reborn-font font-bold truncate max-w-[160px]">📖 ${q.bookTitle}</span>
                            <span class="bg-black/40 px-2 py-0.5 rounded-full text-[10px] text-accent-purple border border-theme">${q.emotion}</span>
                        </div>
                        <p class="text-xs italic text-white/90 bg-black/40 p-3 rounded-xl border-l-2 border-pink-400 mb-2">"${q.text}"</p>
                        ${q.comment ? `<p class="text-[11px] text-accent-pink font-cute">💬 ${q.comment}</p>` : ''}
                    </div>
                    <div class="flex justify-between items-center mt-3 pt-2 border-t border-theme text-[10px] text-accent-purple">
                        <span>${q.chapter}</span>
                        <div class="flex space-x-2">
                            <button onclick="copyQuote('${q.id}')" class="text-xs hover:text-pink-400" title="Copiar"><i class="fa-regular fa-copy"></i></button>
                            <button onclick="deleteQuote('${q.id}')" class="text-xs text-red-400 hover:text-red-300" title="Eliminar"><i class="fa-solid fa-trash"></i></button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function copyQuote(id) {
            const q = quotes.find(x => x.id === id);
            if (q) {
                const textToCopy = `"${q.text}" — ${q.bookTitle} (${q.chapter})`;
                const dummy = document.createElement("textarea");
                document.body.appendChild(dummy);
                dummy.value = textToCopy;
                dummy.select();
                document.execCommand("copy");
                document.body.removeChild(dummy);
            }
        }

        function deleteQuote(id) {
            quotes = quotes.filter(q => q.id !== id);
            saveLocalStorage();
            renderNotes();
        }
    </script>
</body>
</html>
