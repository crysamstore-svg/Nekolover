            <div class="space-y-3">
                <button onclick="applyGlobalTheme('kawaii-dark')" class="w-full p-3 rounded-2xl bg-[#1a1726] border-2 border-[#ff79c6] text-[#ff79c6] flex items-center justify-between font-bold text-xs shadow-md hover:scale-[1.02] transition">
