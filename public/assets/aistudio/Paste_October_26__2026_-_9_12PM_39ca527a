                </div>
            </div>

            <div id="notes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Dynamic Notes -->
            </div>
        </section>
    </main>

    <!-- MODAL: GLOBAL THEME SWITCHER -->
    <div id="modal-global-theme" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-theme-card border border-theme rounded-3xl p-5 max-w-sm w-full shadow-2xl relative modal-animate">
            <button onclick="toggleGlobalThemeModal()" class="absolute top-4 right-4 text-accent-purple hover:text-pink-400"><i class="fa-solid fa-xmark text-lg"></i></button>
