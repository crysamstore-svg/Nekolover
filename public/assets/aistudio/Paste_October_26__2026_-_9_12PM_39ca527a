                    <div class="flex items-center gap-2">
                        <span class="text-lg">🍓</span>
                        <div class="text-left">
                            <p class="font-bold">Vainilla Fresa</p>
                            <p class="text-[10px] text-pink-200 font-normal">Crema Pastel & Fresa Dulce Gótico</p>
                        </div>
                    </div>
                    <i class="fa-solid fa-check theme-check hidden" id="check-vanilla-fresa"></i>
                </button>

                <button onclick="applyGlobalTheme('nocturno')" class="w-full p-3 rounded-2xl bg-[#0b0f19] border-2 border-[#3b82f6] text-[#80b3ff] flex items-center justify-between font-bold text-xs shadow-md hover:scale-[1.02] transition">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">🌙</span>
                        <div class="text-left">
                            <p class="font-bold">Nocturno Ultra Dark</p>
                            <p class="text-[10px] text-blue-200 font-normal">Azul Noche & Plata OLED</p>
                        </div>
                    </div>
                    <i class="fa-solid fa-check theme-check hidden" id="check-nocturno"></i>
                </button>
            </div>
        </div>
